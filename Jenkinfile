pipeline {
    agent { label 'slave' }

    tools {
        maven 'maven'
    }

    environment {
        WEB = 'webapp'
        git_url = 'https://github.com/shinrah/JAVA-Application-.git'
    }

    parameters {
        choice(
            name: 'git_branch',
            choices: ['main', 'dev', 'master'],
            description: 'select the branch name'
        )
    }

    stages {
        stage('clean workspace') {
            steps {
                cleanWs()
            }
        }

        stage('clone the git repo') {
            steps {
                git branch: "${params.git_branch}", url: "${env.git_url}"
            }
        }

        stage('build the maven project') {
            steps {
                dir("${env.WEB}") {
                    sh 'mvn clean deploy'
                }
            }
        }

        stage('test the project') {
            steps {
                sh 'mvn test'
            }
        }

        stage('sonar scan') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('archive the artifact') {
            steps {
                archiveArtifacts artifacts: 'webapp/target/*.war'
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
